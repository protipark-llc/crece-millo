{
  "name": "crece-millo",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de crecimiento integral — Universidad digital con módulo de finanzas personales",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed-demo": "tsx --env-file=.env scripts/seed-demo.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "next build && playwright test",
    "vercel-build": "tsx scripts/migrate.ts --on-build && tsx scripts/bootstrap-user.ts && next build",
    "user:bootstrap": "tsx --env-file=.env scripts/bootstrap-user.ts",
    "copiloto:verificar": "tsx docs/copiloto/motor/verificar.mjs src/lib/copiloto/engine.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.55.0",
    "next": "^15.5.27",
    "pg": "^8.23.1",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "postcss": "^8.5.29"
  }
}
