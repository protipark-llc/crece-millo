# Cadena de conexión a PostgreSQL (desarrollo)
DATABASE_URL=postgres://crece:crece_dev@localhost:5432/crece_dev
# Base de datos aislada para pruebas de integración y E2E (se borra y recrea)
TEST_DATABASE_URL=postgres://crece:crece_dev@localhost:5432/crece_test
# "true" solo detrás de HTTPS (producción). Marca la cookie de sesión como Secure.
SESSION_COOKIE_SECURE=false
# Base de datos para pruebas E2E (Playwright); se recrea en cada ejecución
E2E_DATABASE_URL=postgres://crece:crece_dev@localhost:5432/crece_e2e
# --- Producción (Vercel + Supabase); ver docs/DESPLIEGUE.md ---
# MIGRATION_DATABASE_URL=   # conexión para migraciones (Supabase: Session pooler, puerto 5432)
# DATABASE_CA_CERT=         # certificado raíz PEM de Supabase para TLS verificado
# DATABASE_POOL_MAX=        # conexiones del pool (por defecto 10; 3 en Vercel)
# MIGRATE_ON_BUILD=true     # solo en el entorno Production de Vercel
